{
  "swagger": "2.0",
  "info": {
    "title": "Tasker API",
    "description": "REST API for task management",
    "version": "1.0.0"
  },
  "host": "localhost:8080",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "JWT access token. Format: Bearer <token>"
    }
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication and session management"
    },
    {
      "name": "Tasks",
      "description": "Task management endpoints"
    }
  ],
  "definitions": {
    "User": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "example": 1 },
        "username": { "type": "string", "example": "john_doe" },
        "role": { "type": "string", "enum": ["user", "admin"], "example": "user" },
        "firstName": { "type": "string", "example": "John" },
        "lastName": { "type": "string", "example": "Doe" }
      }
    },
    "RegisterBody": {
      "type": "object",
      "required": ["username", "password", "firstName", "lastName"],
      "properties": {
        "username": {
          "type": "string",
          "example": "john_doe",
          "description": "3–30 chars, alphanumeric + _ . -"
        },
        "password": {
          "type": "string",
          "example": "securePass123",
          "description": "Minimum 8 characters"
        },
        "firstName": { "type": "string", "example": "John", "description": "1–50 chars" },
        "lastName": { "type": "string", "example": "Doe", "description": "1–50 chars" },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "default": "user",
          "description": "Optional. Defaults to 'user'."
        }
      }
    },
    "LoginBody": {
      "type": "object",
      "required": ["username", "password"],
      "properties": {
        "username": { "type": "string", "example": "john_doe" },
        "password": { "type": "string", "example": "securePass123" }
      }
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "example": 1 },
        "title": { "type": "string", "example": "Fix login bug" },
        "description": { "type": "string", "example": "Users can't log in with Google OAuth" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"], "example": "high" },
        "status_id": { "type": "integer", "example": 1 },
        "status": { "type": "string", "example": "todo" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "CreateTaskBody": {
      "type": "object",
      "required": ["title", "priority"],
      "properties": {
        "title": { "type": "string", "example": "Fix login bug" },
        "description": { "type": "string", "example": "Users can't log in with Google OAuth" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"], "example": "medium" },
        "status_id": { "type": "integer", "example": 1, "description": "Optional. Defaults to first status in DB." }
      }
    },
    "UpdateTaskBody": {
      "type": "object",
      "required": ["task"],
      "properties": {
        "task": {
          "type": "object",
          "description": "Fields to update (partial update supported)",
          "properties": {
            "title": { "type": "string", "example": "Updated title" },
            "description": { "type": "string", "example": "Updated description" },
            "priority": { "type": "string", "enum": ["low", "medium", "high"], "example": "low" },
            "status_id": { "type": "integer", "example": 2 }
          }
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "message": { "type": "string", "example": "Invalid credentials" }
      }
    },
    "TaskErrorResponse": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "example": "500" },
        "message": { "type": "string", "example": "Internal server error" }
      }
    },
    "TaskStats": {
      "type": "object",
      "properties": {
        "counts_by_status": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status_id": { "type": "integer", "example": 1 },
              "status": { "type": "string", "example": "todo" },
              "tasks_count": { "type": "integer", "example": 5 }
            }
          }
        },
        "oldest_task": { "$ref": "#/definitions/Task" },
        "newest_task": { "$ref": "#/definitions/Task" }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "description": "Creates a new user account. Username must be unique.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/RegisterBody" }
          }
        ],
        "responses": {
          "201": {
            "description": "User created",
            "schema": {
              "type": "object",
              "properties": {
                "user": { "$ref": "#/definitions/User" }
              }
            }
          },
          "400": {
            "description": "Validation error (missing fields, invalid format)",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "409": {
            "description": "Username already exists",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in",
        "description": "Authenticates user and returns a JWT access token. Sets an HTTP-only `refreshToken` cookie (7 days by default).",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/LoginBody" }
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful",
            "schema": {
              "type": "object",
              "properties": {
                "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
                "user": { "$ref": "#/definitions/User" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh access token",
        "description": "Issues a new access token using the `refreshToken` cookie. Rotates the refresh token (old session is revoked).",
        "responses": {
          "200": {
            "description": "New access token issued",
            "schema": {
              "type": "object",
              "properties": {
                "accessToken": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
              }
            }
          },
          "401": {
            "description": "Refresh token missing or invalid",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log out",
        "description": "Revokes the current session and clears the `refreshToken` cookie. Always returns 200.",
        "responses": {
          "200": {
            "description": "Logged out",
            "schema": {
              "type": "object",
              "properties": {
                "ok": { "type": "boolean", "example": true }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get current user",
        "description": "Returns the authenticated user's info extracted from the JWT.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user info",
            "schema": {
              "type": "object",
              "properties": {
                "id": { "type": "integer", "example": 1 },
                "username": { "type": "string", "example": "john_doe" },
                "role": { "type": "string", "example": "user" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get all tasks",
        "description": "Returns a paginated list of tasks with optional filtering and sorting.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Comma-separated list of status IDs to filter by (e.g. '1,2')",
            "type": "string",
            "example": "1,2"
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "Field to sort by",
            "type": "string",
            "enum": ["id", "title", "priority", "status", "created_at"],
            "default": "id"
          },
          {
            "name": "order",
            "in": "query",
            "description": "Sort direction",
            "type": "string",
            "enum": ["asc", "desc"],
            "default": "desc"
          },
          {
            "name": "priority",
            "in": "query",
            "description": "Filter by priority (partial match)",
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search string matched against title and description (case-insensitive)",
            "type": "string"
          },
          {
            "name": "task_id",
            "in": "query",
            "description": "Filter by exact task ID",
            "type": "integer"
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number (1-based)",
            "type": "integer",
            "default": 1,
            "minimum": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of tasks per page (1–500)",
            "type": "integer",
            "default": 100,
            "minimum": 1,
            "maximum": 500
          }
        ],
        "responses": {
          "200": {
            "description": "List of tasks",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "example": "200" },
                "result": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/Task" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "403": { "description": "Forbidden", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/TaskErrorResponse" } },
          "503": { "description": "Database host unreachable", "schema": { "$ref": "#/definitions/TaskErrorResponse" } },
          "504": { "description": "Database query timeout", "schema": { "$ref": "#/definitions/TaskErrorResponse" } }
        }
      }
    },
    "/task": {
      "post": {
        "tags": ["Tasks"],
        "summary": "Create a task",
        "description": "Creates a new task. If status_id is not provided, defaults to the first status in the database.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/CreateTaskBody" }
          }
        ],
        "responses": {
          "200": {
            "description": "Task created",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "example": "200" },
                "result": { "type": "string", "example": "ok" }
              }
            }
          },
          "400": { "description": "Validation error (title or priority missing, invalid status_id)", "schema": { "$ref": "#/definitions/TaskErrorResponse" } },
          "401": { "description": "Unauthorized", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "403": { "description": "Forbidden", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/TaskErrorResponse" } }
        }
      }
    },
    "/task/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task by ID",
        "description": "Returns a single task by its ID.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Task ID",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Task found",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "example": "200" },
                "result": { "$ref": "#/definitions/Task" }
              }
            }
          },
          "401": { "description": "Unauthorized", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "403": { "description": "Forbidden", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/TaskErrorResponse" } }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Update task",
        "description": "Updates task fields. Only fields present in the 'task' object are updated (partial update).",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Task ID",
            "type": "integer"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/UpdateTaskBody" }
          }
        ],
        "responses": {
          "200": {
            "description": "Task updated, returns updated task",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "example": "200" },
                "result": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/Task" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "403": { "description": "Forbidden", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/TaskErrorResponse" } }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete task",
        "description": "Deletes a task by ID. Returns the deleted task object.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Task ID",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Task deleted, returns the deleted task",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "example": "200" },
                "result": { "$ref": "#/definitions/Task" }
              }
            }
          },
          "401": { "description": "Unauthorized", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "403": { "description": "Forbidden", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/TaskErrorResponse" } }
        }
      }
    },
    "/tasks/status/": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get tasks by status IDs",
        "description": "Returns all tasks matching one or more status IDs. Ordered by task ID descending.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Comma-separated list of status IDs (e.g. '1,2,3')",
            "type": "string",
            "example": "1,2"
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching tasks",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "example": "200" },
                "result": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/Task" }
                }
              }
            }
          },
          "400": { "description": "Status ID is required", "schema": { "$ref": "#/definitions/TaskErrorResponse" } },
          "401": { "description": "Unauthorized", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "403": { "description": "Forbidden", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/TaskErrorResponse" } }
        }
      }
    },
    "/tasks/stats": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task statistics",
        "description": "Returns task counts grouped by status, plus the oldest and newest task.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Task statistics",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "example": "200" },
                "data": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/TaskStats" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "403": { "description": "Forbidden", "schema": { "$ref": "#/definitions/ErrorResponse" } },
          "500": { "description": "Internal server error", "schema": { "$ref": "#/definitions/TaskErrorResponse" } }
        }
      }
    }
  }
}
